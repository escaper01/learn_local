{
  "name": "learnlocal",
  "version": "0.1.0",
  "main": "./out/main/main.js",
  "private": true,
  "description": "An offline-first desktop application for portable, interactive programming courses.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "dompurify": "3.4.15"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "learnpack:example": "node scripts/generate-example-learnpack.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
