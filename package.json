{
  "name": "learnlocal",
  "version": "0.2.0",
  "main": "./out/main/main.js",
  "private": true,
  "description": "An offline-first desktop application for portable, interactive technical courses.",
  "author": "LearnLocal Contributors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "dompurify": "3.4.17",
    "@electron/universal": "3.0.6",
    "app-builder-lib": {
      "minimatch": "11.0.8"
    }
  },
  "scripts": {
    "predev": "install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "prepreview": "install-electron --no",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "learnpack:example": "node scripts/generate-example-learnpack.mjs",
    "assets:icons": "node scripts/generate-app-icon.mjs",
    "curriculum:package": "node scripts/package-java-curriculum.mjs",
    "curriculum:electronics:build": "node scripts/build-electronics-curriculum.mjs && node scripts/build-electronics-technical-diagrams.mjs",
    "curriculum:electronics:verify": "node scripts/verify-electronics-curriculum.mjs",
    "curriculum:electronics:package": "node scripts/package-electronics-curriculum.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "dev.learnlocal.desktop",
    "productName": "LearnLocal",
    "asar": true,
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "escaper01",
      "repo": "learn_local"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "LearnLocal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "LearnLocal-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
