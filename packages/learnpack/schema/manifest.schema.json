{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlocal.dev/schema/1.0/manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "id", "version", "course", "runtime", "modules", "projects"],
  "properties": {
    "format": { "const": "learnpack" },
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "language", "languageVersion", "level", "estimatedHours", "authors"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "language": { "enum": ["java", "python"] },
        "languageVersion": { "type": "string", "minLength": 1, "maxLength": 30 },
        "level": { "enum": ["beginner", "intermediate", "advanced"] },
        "estimatedHours": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 } }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapterRange", "runtimeVersion"],
      "properties": {
        "adapter": { "enum": ["java", "python"] },
        "adapterRange": { "type": "string", "minLength": 1, "maxLength": 100 },
        "runtimeVersion": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/jsonPath" }
    },
    "projects": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/jsonPath" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
    "jsonPath": { "type": "string", "pattern": "^(content|projects)/[a-zA-Z0-9._/-]+\\.json$", "maxLength": 240 }
  }
}
