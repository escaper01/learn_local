{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlocal.dev/schema/1.0/project.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "descriptionMarkdown", "checkpointExerciseIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "descriptionMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
    "learningObjectives": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "checkpointExerciseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" }
    }
  }
}
