{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learnlocal.dev/schema/1.0/module.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "lessons"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/lesson" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,79}$" },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "theoryMarkdown", "exercises"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "theoryMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "exercises": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "instructionMarkdown"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["output", "function", "debug", "multipleChoice", "project"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "instructionMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "starterFiles": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240 },
              "content": { "type": "string", "maxLength": 500000 }
            }
          }
        },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "function" },
            "className": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
            "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
            "parameters": { "type": "array", "maxItems": 1 },
            "returns": { "type": "string", "maxLength": 80 }
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "visibility", "expected"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "visibility": { "enum": ["public", "hidden"] },
              "arguments": { "type": "array", "maxItems": 20 },
              "input": { "type": "string", "maxLength": 100000 },
              "expected": {},
              "comparison": { "enum": ["exact", "trimmed", "lines", "numeric"] }
            }
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "correctChoice": { "type": "integer", "minimum": 0, "maximum": 11 },
        "hints": {
          "type": "array",
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
            "memoryMb": { "type": "integer", "minimum": 32, "maximum": 1024 },
            "maxOutputKb": { "type": "integer", "minimum": 1, "maximum": 1024 }
          }
        }
      }
    }
  }
}
